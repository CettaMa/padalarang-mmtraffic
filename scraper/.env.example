# Input and output
CCTV_CONFIG_FILE=cctv_points.csv
CCTV_OUTPUT_ROOT=dataset

TOMTOM_API=isi_dengan_api_key_anda

# Video segmentation
VIDEO_CONTAINER=ts
# SEGMENT_SECONDS: Code default is 60 (reconciled from 28)
SEGMENT_SECONDS=60

# HLS stability - recommended for unstable public HLS CCTV
HLS_RECONNECT_AT_EOF=false
HLS_LIVE_START_INDEX=-1
SEGMENT_ATCLOCKTIME=false
PREFLIGHT_CHECK=true
FFMPEG_RECONNECT_ON_HTTP_ERROR=5xx
OFFLINE_RETRY_SECONDS=300
NETWORK_RETRY_SECONDS=60
RESTART_DELAY_SECONDS=5
HEALTH_CHECK_SECONDS=30
STALE_FILE_SECONDS=240
FFMPEG_RW_TIMEOUT=10000000
FFMPEG_RECONNECT_DELAY_MAX=10

# HTTP keep-alive for the HLS input. Keep these true: with them off FFmpeg opens
# a new TCP+TLS connection per playlist reload and per segment (~8/second across
# 8 cameras), which fills the host conntrack table and the upstream router's NAT
# session table until outbound TCP dies and only a reboot clears it.
# Set to false only if a specific source server misbehaves with keep-alive.
FFMPEG_HTTP_PERSISTENT=true
FFMPEG_MULTIPLE_REQUESTS=true

# Restart the process when NO camera has been reachable for this long -- that is
# a host connectivity failure, not a stream outage. A restart drops every stale
# socket. Set to 0 to disable.
NETWORK_WATCHDOG_SECONDS=600

# Recommended recording mode
# copy = lightweight & stable for raw stream capture.
# smooth/transcode = re-encodes for CFR and predictable bitrate.
FFMPEG_TRANSPORT_MODE=copy

# Transcode options, only used when FFMPEG_TRANSPORT_MODE=smooth or transcode
# Recorder transcode path supports only hevc_nvenc, h264_nvenc, libx265, libx264.
# QSV/VA-API are not accepted here; unused while FFMPEG_TRANSPORT_MODE=copy.
VIDEO_ENCODER=libx264
OUTPUT_FPS=10
OUTPUT_HEIGHT=0
TRANSCODE_PRESET=p4
TARGET_BITRATE=650k
MAX_BITRATE=900k
BUFFER_SIZE=1300k
SEGMENT_KEYFRAME_SECONDS=2

# Daily archiving
# There is no local re-encoding step: raw .ts segments are packaged as-is into
# one uncompressed (Store mode) 7z per completed date. ARCHIVE_SAFE_AGE_SECONDS
# is the safety margin after a day's last write before that day is packaged --
# the recorder may still be closing its last segment around midnight.
ARCHIVE_SAFE_AGE_SECONDS=90
DAILY_ARCHIVE_ENABLED=true
DAILY_ARCHIVE_SCAN_SECONDS=300
DAILY_ARCHIVE_DELETE_SOURCE=false
ARCHIVER_BINARY=7z

# FFmpeg diagnostics
FFMPEG_LOGLEVEL=warning
FFMPEG_ANALYZEDURATION=10000000
FFMPEG_PROBESIZE=10000000
FFMPEG_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
FFMPEG_REFERER=https://atcs-dishubkbb.urbanaccess.net/
FFMPEG_ORIGIN=https://atcs.bandungbaratkab.go.id

# Metadata intervals
# METADATA_INTERVAL_SECONDS: Code default is 60 (reconciled from 300)
METADATA_INTERVAL_SECONDS=60
# Keep a minimum gap even when a metadata pass overruns its interval.
METADATA_MIN_PASS_INTERVAL_SECONDS=5
# Back off metadata passes after repeated API request failures.
METADATA_FAILURE_BACKOFF_BASE_SECONDS=5
METADATA_FAILURE_BACKOFF_MAX_SECONDS=300
TOMTOM_INTERVAL_SECONDS=300
# OPENMETEO_INTERVAL_SECONDS: Code default is 60 (reconciled from 300)
OPENMETEO_INTERVAL_SECONDS=60

# Storage lifecycle
DISK_CHECK_SECONDS=300
RETENTION_DAYS=7
MIN_FREE_SPACE_GB=20
# Rotating application/point log limits.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Escalate repeated expired memfs URLs in the point status CSV.
EXPIRED_URL_ESCALATION_THRESHOLD=3

# Fallback coordinate if CSV lat/lon is empty
DEFAULT_LAT=-6.851117
DEFAULT_LON=107.496586

# ---------------------------------------------------------------------------
# Monitoring dashboard (separate process; read-only against the dataset)
# ---------------------------------------------------------------------------
# Bind address inside the process. Compose overrides this to 0.0.0.0 and maps
# the host port with DASHBOARD_HOST_PORT instead.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Host-side port published by the Compose service.
DASHBOARD_HOST_PORT=8080

# Camera memfs URLs are credentials, so the dashboard refuses to start with
# auth enabled and an empty password. To run without auth, set
# DASHBOARD_AUTH_ENABLED=false AND DASHBOARD_HOST=127.0.0.1.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# SQLite roll-up so uptime and coverage history survive log rotation and
# RETENTION_DAYS pruning. It is the only thing the dashboard writes.
DASHBOARD_HISTORY_ENABLED=true
DASHBOARD_HISTORY_DB=dataset/dashboard/history.db
DASHBOARD_HISTORY_INTERVAL_SECONDS=60
DASHBOARD_HISTORY_RETENTION_DAYS=90

# Response cache and tail sizes. Raising the status tail widens the uptime
# window that can be reconstructed from CSV before history takes over.
DASHBOARD_CACHE_TTL_SECONDS=15
DASHBOARD_STATUS_TAIL_LINES=5000
DASHBOARD_LOG_TAIL_LINES=200
